app/mobile/modules/tlsn-native/tlsn-native
# Site build settings (fork/config.example.env)
fork/config.env
# Generated by fork/build.sh
packages/extension/src/gcp-private/*.mjs
packages/extension/src/gcp-private/generated/
packages/extension/src/aws-private/*.mjs
packages/extension/src/cloudflare-private/*.mjs
# Pinned TLSNotary core for the native verifier (core/prepare-core.sh)
core/tlsn/
core/tlsn.prepare.lock
# Demo attestor key (examples/demo/make-attestor-key.mjs)
attestor-key.json
