# Build settings for your site's extension. Copy to fork/config.env (git-ignored), set the values, then
# `npm run build:fork`. Format: KEY=value, one per line, no shell code; a value may be wrapped in double quotes.
# Environment variables override this file; FORK_CONFIG=<file> builds from another file.
# Relative paths are relative to the repository root. Nothing here is a secret.
#
# Leave everything empty for a development build (localhost origins, no stable extension id).
# Setting FORK_KEY_FILE makes a production build, which also requires FORK_PRODUCT_ORIGINS (and
# FORK_CF_OAUTH_CLIENT_ID when the plugins include cloudflare-private-work); the build stops without them.
#
# The TLSNotary verifier and proxy URLs are not build settings: your page passes them with each run
# (verifierUrl, proxyUrl, see "Build for your site" in docs/architecture.md).

# --- Required for a production build ---

# Comma-separated origins of your pages allowed to use the page API (https://host[:port], no loopback hosts).
# Dev default: http://localhost:5173, http://127.0.0.1:5173 and the same on port 5175.
FORK_PRODUCT_ORIGINS=

# Base64 DER public key of your extension, written as the manifest `key` (stable extension id, printed to
# fork/out/extension-id.txt). Only the public key: keep the private key for signing your Web Store package.
FORK_KEY_FILE=

# Directory of your built plugin bundles, one <id>.js per plugin the extension may run. The extension runs no other
# plugin code. Empty: gcp-work.js, aws-private-work.js and cloudflare-private-work.js, built from
# private-proof/*/plugin.ts into fork/out/plugins (fork/build-plugins.mjs).
FORK_PLUGIN_DIR=

# Your public Cloudflare OAuth client id (Authorization Code + PKCE, no client secret). Its redirect URI is
# https://<extension id>.chromiumapp.org/. Required in a production build that packages cloudflare-private-work.js.
FORK_CF_OAUTH_CLIENT_ID=

# --- Optional ---

# Manifest name (default "TLSN Extension (dev)", or "TLSN Extension" with FORK_KEY_FILE).
FORK_NAME=

# Manifest description, at most 132 characters.
FORK_DESCRIPTION=

# Directory with icon-16.png, icon-34.png, icon-48.png and icon-128.png (default: upstream's icons).
FORK_ICON_DIR=

# Comma-separated exact https URLs (no query or fragment) a plugin may send its own window to, e.g. an account
# switcher. Default none.
FORK_NAVIGATE_URLS=

# Comma-separated extra host match patterns (https://host/path*) for content scripts and host access, e.g. for
# those navigation targets. Default none.
FORK_EXTRA_HOSTS=

# The pinned Noir compiler for the private-proof circuits (default: nargo on PATH).
GCP_NOIR_NARGO=
